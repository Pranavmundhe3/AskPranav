# Copy this file to .env and fill in real values. Never commit .env itself (already gitignored).

# --- Postgres (used by both docker-compose.yml and the Spring Boot app) ---
DB_HOST=localhost
# 5433, not 5432, if a natively installed Postgres already owns 5432 on your machine.
DB_PORT=5433
DB_NAME=askpranav
DB_USERNAME=askpranav
DB_PASSWORD=changeme

# --- LLM: Gemini API key (Google AI Studio) for BOTH chat and embeddings ---
# Uses Spring AI's native Google GenAI client - no GCP project needed. Gemini is the only model provider.
# Free-tier keys have small daily/per-minute quotas, and one question makes several model calls.
GEMINI_API_KEY=
ASKPRANAV_GEMINI_MODEL=gemini-3.6-flash
ASKPRANAV_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Must match the embedding model's output size. pgvector's HNSW index caps at 2000 dims.
EMBEDDING_DIMENSIONS=768

# --- Rate limit on POST /ask/question (per client IP, sliding window) ---
ASKPRANAV_RATE_LIMIT_MAX=2
ASKPRANAV_RATE_LIMIT_WINDOW_SECONDS=300
# Set to "native" behind a reverse proxy so the limiter sees each visitor's real IP. Keep "none" otherwise.
ASKPRANAV_FORWARD_HEADERS=none

# --- Ingestion ---
# if-empty: only embed on startup if the vector store looks empty (default). always: re-embed every startup (dev).
ASKPRANAV_INGESTION_MODE=if-empty

# Repos or accounts whose READMEs are ingested: owner/repo, a repo URL, or an account URL (all its public non-fork repos)
ASKPRANAV_GITHUB_REPOS=https://github.com/your-account

# --- Write-endpoint login (POST .../save-*). No default password: leave empty and all writes are rejected ---
ASKPRANAV_ADMIN_USER=admin
ASKPRANAV_ADMIN_PASSWORD=

# --- Contact form email ---
# Where messages are delivered (no default, the repo is public):
ASKPRANAV_CONTACT_TO=
# SMTP login. For Gmail: turn on 2-Step Verification, then create an App Password and use it here.
MAIL_USERNAME=
# If the value contains spaces (Gmail shows app passwords in groups), wrap it in double quotes.
MAIL_PASSWORD=
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587

# --- Folder watched while the app runs (new/changed/deleted files are picked up within seconds) ---
# ASKPRANAV_KNOWLEDGE_DIR=src/main/resources/knowledge
# ASKPRANAV_KNOWLEDGE_SCAN_MS=10000

# --- MCP endpoint login (GET /sse, POST /mcp/message). No default password: leave empty and those endpoints reject everyone ---
ASKPRANAV_MCP_USER=mcp
ASKPRANAV_MCP_PASSWORD=

# --- One-time DB resync: set to true, restart once, then set back to false ---
# Clears personal/education/experience/skills/certifications/summary/publications and reseeds them
# from DataSeeder.java (which is otherwise write-once - edits to it do nothing once those tables
# already have rows). Projects are never cleared this way; DataSeeder's two named projects still sync
# by name on every restart regardless of this flag.
ASKPRANAV_RESEED=false
