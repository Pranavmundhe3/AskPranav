# Copy this file to .env and fill in real values. Never commit .env itself (already gitignored).

# --- Postgres (used by both docker-compose.yml and the Spring Boot app) ---
DB_HOST=localhost
# 5433, not 5432, if a natively installed Postgres already owns 5432 on your machine.
DB_PORT=5433
DB_NAME=askpranav
DB_USERNAME=askpranav
DB_PASSWORD=changeme

# --- LLM: Gemini API key (Google AI Studio) for BOTH chat and embeddings ---
# Uses Spring AI's native Google GenAI client - no GCP project needed. (Not the OpenAI-compatibility
# endpoint: Gemini 3 models require a thought_signature on tool calls, which the compat path drops.)
# Free-tier keys are capped at a few requests/minute per model, and one question makes several calls.
GEMINI_API_KEY=
ASKPRANAV_AI_PROVIDER=google-genai
ASKPRANAV_GEMINI_MODEL=gemini-3.6-flash
ASKPRANAV_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Must match the embedding model's output size. pgvector's HNSW index caps at 2000 dims.
EMBEDDING_DIMENSIONS=768

# --- Alternative: Claude for chat (Anthropic has no embedding model, so embeddings stay on Gemini) ---
# ASKPRANAV_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ASKPRANAV_ANTHROPIC_MODEL=claude-sonnet-5

# --- Alternative: OpenAI for chat and/or embeddings ---
# ASKPRANAV_AI_PROVIDER=openai
# ASKPRANAV_EMBEDDING_STARTER=openai
# OPENAI_API_KEY=
# ASKPRANAV_OPENAI_MODEL=gpt-4o-mini
# ASKPRANAV_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# --- Ingestion ---
# if-empty: only embed on startup if the vector store looks empty (default). always: re-embed every startup (dev).
ASKPRANAV_INGESTION_MODE=if-empty

# comma-separated owner/repo slugs whose README.md should be ingested, e.g. Pranavmundhe3/AskPranav
ASKPRANAV_GITHUB_REPOS=
